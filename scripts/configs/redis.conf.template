port ${PORT}
cluster-enabled yes

bind 0.0.0.0

dir ${WORKSPACE}/redis/configs/${PORT}

cluster-config-file ${WORKSPACE}/redis/configs/${PORT}/nodes.conf
cluster-node-timeout 5000

# AOF persistence
appendonly yes
appendfilename "appendonly.aof"

# Redis 7+: AOF files (base, incr, manifest) go into a subdirectory
# under `dir`, so this resolves to ${WORKSPACE}/redis/configs/${PORT}/appendonlydir
appenddirname "appendonlydir"