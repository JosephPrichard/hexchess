<!doctype html>
<html lang="en">
<head>
    <title>Profile - Hexchess</title>
    <link rel="stylesheet" href="/static/css/index.css">
    <script src="/static/js/pages/profile.js"></script>
    <script src="/static/js/lib/notifications.js"></script>
</head>
<body>
{{> partials/banner }}
<div class="bottom-right-anchor" style="width: 350px" id="notifications-box"></div>
<div class="center-horizontal-container">
    <div style="width: 500px">
        <div class="title-lg" style="padding-left: 0">
            Edit Profile
        </div>
        <form id="update-user-form" class="form-wrapper">
            <label for="username" style="font-size: 17px">Username</label>
            <input id="username" name="username" placeholder="Username" value="{{user.username}}" style="margin-top: 5px; margin-bottom: 10px;"/>

            <label for="bio" style="font-size: 17px">Biography</label>
            <textarea id="bio" name="bio" rows="8" style="padding: 8px; font-size: 14px">{{user.bio}}</textarea>

            <label for="country" style="font-size: 17px">Country</label>
            <div class="country-wrapper">
                <img class="country-image"
                     id="selected-country"
                     src="/static/images/flags/{{user.country}}.png"
                     alt="{{user.country}}"
                     onclick="toggleCountryDropdown()"
                     data-country="{{user.country}}" />
                <div id="country-select-options" class="country-picker" style="display: none">
                    {{#each countries}}
                        <img class="country-image"
                             src="/static/images/flags/{{this}}.png"
                             alt="{{this}}"
                             onclick="onSelectCountry('{{this}}')" />
                    {{/each}}
                </div>
            </div>
            <button id="user-form-submit" class="button button-grey" type="submit" style="margin-top: 15px;">
                Submit
            </button>
        </form>
        <div class="title-lg" style="padding-left: 0">
            Update Password
        </div>
        <form id="update-password-form" class="form-wrapper">
            <label for="password" style="font-size: 17px">Current Password</label>
            <input id="password" type="password" name="password" placeholder="Password" value="" style="margin-top: 5px; margin-bottom: 10px;"/>

            <label for="new-password" style="font-size: 17px">New Password</label>
            <input id="new-password" type="password" name="new-password" placeholder="Password" value="" style="margin-top: 5px; margin-bottom: 15px;"/>
            <label for="retype-password" style="font-size: 17px">Retype New Password</label>

            <input id="retype-password" type="password" name="retype-password" placeholder="Password" value="" style="margin-top: 5px; margin-bottom: 15px;"/>
            <button id="password-form-submit" class="button button-grey" type="submit">
                Submit
            </button>
            <div id="update-password-form-message" style="margin-top: 20px; min-height: 20px;"></div>
        </form>
        <br>
        <button id="sign-out-button" class="button button-red">
            Sign Out
        </button>
        <div style="height: 100px;"></div>
    </div>
</div>
</body>
<script>
    renderProfile();
</script>
</html>