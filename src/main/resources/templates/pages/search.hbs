<!doctype html>
<html lang="en">
<head>
    <title>Search - Hexchess</title>
    <link rel="stylesheet" href="/static/css/index.css">
</head>
<body>
{{> partials/banner }}
<div class="center-horizontal-container">
    <div class="title-lg">
        Search
    </div>
    <div class="wrapper">
        <form class="form-wrapper">
            <label for="username"></label>
            <input id="username" name="username" placeholder="Username" value="{{searchText}}" style="width: 50%; top: 4px; position: relative"/>
            <div class="button-submit-vertical-form">
                <button class="button button-grey" type="submit"> Search </button>
            </div>
        </form>
        {{#if searchText}}
            {{> partials/statsList }}
        {{/if}}
    </div>
</div>
{{#if searchText}}
    {{> partials/pagination pages }}
{{/if}}
</body>
</html>