<!doctype html>
<html lang="en">
<head>
    <title>Challenges - Hexchess</title>
    <link rel="stylesheet" href="/static/css/index.css">
    <script src="/static/js/pages/challenges.js" defer></script>
</head>
<body>
{{> partials/banner }}
<div class="center-horizontal-container" style="margin-bottom: 100px">
    <div style="width: 500px;">
        <div class="tabs-group">
            <a class="tab" href="?participants=sent">
                Sent
            </a>
            <a class="tab" href="?participants=received">
                Received
            </a>
        </div>
        {{#each challengeList}}
            <div id="challenge-{{@index}}" class="challenge-box">
                <div>
                    <div style="margin-bottom: 5px">
                        <a href="/players/{{challengerId}}" class="text-ul" style="color: dodgerblue">
                            {{challengerName}}
                        </a>
                        {{#unless areSent}}
                            <b>({{challengerEloFmt}})</b>
                        {{/unless}}
                        vs
                        <a href="/players/{{challengeeId}}" class="text-ul" style="color: dodgerblue">
                            {{challengeeName}}
                        </a>
                        {{#if areSent}}
                            <b>({{challengeeEloFmt}})</b>
                        {{/if}}
                    </div>
                    <div style="margin-bottom: 5px">
                        Sent <b> {{madeAgo}} </b>
                    </div>
                    <div style="margin-bottom: 5px">
                        Expires <b> {{expiresIn}} </b>
                    </div>
                </div>
                <div class="center-relative">
                    <div class="vertical-align">
                        {{#if areSent}}
                            <button id="challenge-{{@index}}-delete"
                                    class="button-small button-small-red"
                                    style="margin-left: 5px"
                                    onclick="onDelete({{@index}}, '{{challengerId}}', '{{challengeeId}}')">
                                Delete
                            </button>
                        {{else}}
                            <button id="challenge-{{@index}}-accept"
                                    class="button-small button-small-green"
                                    style="margin-left: 5px"
                                    onclick="onAccept({{@index}}, '{{challengerId}}', '{{challengeeId}}')">
                                Accept
                            </button>
                            <button id="challenge-{{@index}}-reject"
                                    class="button-small button-small-red"
                                    style="margin-left: 5px"
                                    onclick="onReject({{@index}}, '{{challengerId}}', '{{challengeeId}}')">
                                Reject
                            </button>
                        {{/if}}
                    </div>
                </div>
            </div>
        {{/each}}
        {{#unless challengeList.length}}
            <div class="color-wrapper">
                {{#if areSent}}
                    No challenges have been sent
                {{else}}
                    No challenges have been received
                {{/if}}
            </div>
        {{/unless}}
    </div>
</div>
</body>
</html>