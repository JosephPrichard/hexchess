<!doctype html>
<html lang="en">
<head>
    <title>Challenges - Hexchess</title>
    <link rel="stylesheet" href="/static/css/index.css">
    <script type="module">

    </script>
</head>
<body>
    {{> partials/banner }}
    <div class="center-horizontal-container" style="margin-bottom: 100px">
        {{#if challengeList.length}}
        {{#each challengeList as |c|}}
        <div class="challenge-box">
            <div>
                <div style="margin-bottom: 5px">
                    <a href="/players/{{c.challengerId}}" class="text-ul" style="color: dodgerblue">{{c.challengerName}}</a>
                    <b>({{c.roundedChallengerElo}})</b>
                    vs
                    <a href="/players/{{c.challengeeId}}" class="text-ul" style="color: dodgerblue">{{c.challengeeName}}</a>
                    <b>({{c.roundedChallengeeElo}})</b>
                </div>
                <div style="margin-bottom: 5px">
                    Made On: <b> {{c.formattedMadeOn}} </b>
                </div>
                <div style="margin-bottom: 5px">
                    Expires On: <b> {{c.formattedExpiresOn}} </b>
                </div>
                <div class="{{c.statusColor}}" style="margin-bottom: 5px">
                    {{c.formattedStatus}}
                </div>
            </div>
            <div class="center-relative">
                <div>
                    {{#unless areSent}}
                    <button class="button-grey button-green" style="margin-left: 5px">
                        Accept
                    </button>
                    {{/unless}}
                    {{#if areSent}}
                    <button class="button-grey button-red" style="margin-left: 5px">
                        Delete
                    </button>
                    {{else}}
                    <button class="button-grey button-red" style="margin-left: 5px">
                        Reject
                    </button>
                    {{/if}}
                </div>
            </div>
        </div>
        {{/each}}
        {{else}}
            <div class="color-wrapper">
                No challenges have been made
            </div>
        {{/if}}
    </div>
</body>