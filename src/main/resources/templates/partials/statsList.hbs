{{#if userList.length}}
    <table id="stats-table" class="table-container">
        <thead>
        <tr>
            <th>Rank</th>
            <th>Player</th>
            <th>Elo</th>
            <th>Win%</th>
            <th>Won</th>
            <th>Lost</th>
            <th>Total</th>
        </tr>
        </thead>
        <tbody>
        {{#each userList}}
            <tr id="user-{{id}}" class="row-hover" onclick="window.location = '/players/{{id}}';">
                <td style="width: 9%">
                    {{rank}}
                </td>
                <td style="width: 43%">
                    {{username}}
                    <img class="flag" src="/static/images/flags/{{country}}.png" alt=""/>
                </td>
                <td style="width: 12%">
                    {{eloFmt}}
                </td>
                <td class="{{winRateColor}}" style="width: 9%;">
                    {{winRate}}%
                </td>
                <td class="green-color" style="width: 9%">
                    {{wins}}
                </td>
                <td class="red-color" style="width: 9%">
                    {{losses}}
                </td>
                <td style="width: 9%">
                    {{total}}
                </td>
            </tr>
        {{/each}}
        </tbody>
    </table>
{{else}}
    <div class="color-wrapper">
        No players to show
    </div>
{{/if}}
