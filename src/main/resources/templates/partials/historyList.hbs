{{#each this as |h|}}
<tr id="history-{{h.id}}"
    data-id="{{h.id}}"
    class="row-hover"
    onclick="window.location = '/games/histories/{{h.id}}';">

    <td style="width: 25%">
        <a href="/players/{{h.whiteId}}" class="text-ul">{{h.whiteName}}</a>
        <img class="flag" src="/files/flags/{{h.whiteCountry}}.png" alt=""/>
        <span class="{{h.whiteEloColor}}">
            {{h.whiteEloDiff}}
        </span>
    </td>
    <td style="width: 25%">
        <a href="/players/{{h.blackId}}" class="text-ul">{{h.blackName}}</a>
        <img class="flag" src="/files/flags/{{h.blackCountry}}.png" alt=""/>
        <span class="{{h.blackEloColor}}" >
            {{h.blackEloDiff}}
        </span>
    </td>
    <td style="width: 25%">
        {{h.formattedResult}}
    </td>
    <td style="width: 25%;">
        {{h.formattedPlayedOn}}
    </td>
</tr>
{{/each}}