<div class="pagination">
    {{#if leftPage}}
        <a class="page-button" href="{{leftPage}}">
            &#11164;
        </a>
    {{/if}}
    {{#each pages}}
        <a class="page-button" href="{{location}}">
            {{value}}
        </a>
    {{/each}}
    {{#if rightPage}}
        <a class="page-button" href="{{rightPage}}">
            &#11166;
        </a>
    {{/if}}
</div>