{{#each this}}
    <tr id="replay-{{id}}"
        data-id="{{id}}"
        class="row-hover"
        onclick="window.location = '/games/replay/{{id}}';">

        <td style="width: 25%">
            <a href="/players/{{whiteId}}" class="text-ul">{{whiteName}}</a>
            <img class="flag" src="/static/images/flags/{{whiteCountry}}.png" alt=""/>
            <span class="{{whiteEloColor}}">
                {{whiteEloDiff}}
            </span>
        </td>
        <td style="width: 25%">
            <a href="/players/{{blackId}}" class="text-ul">{{blackName}}</a>
            <img class="flag" src="/static/images/flags/{{blackCountry}}.png" alt=""/>
            <span class="{{blackEloColor}}" >
                {{blackEloDiff}}
            </span>
        </td>
        <td style="width: 25%">
            {{resultFmt}}
        </td>
        <td style="width: 25%;">
            {{playedOnFmt}}
        </td>
    </tr>
{{/each}}